<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>PACMAN</AssemblyName>
    <RootNamespace>PacmanWinForms</RootNamespace>
    <ApplicationIcon>Icon.ico</ApplicationIcon>

    <!-- On garde le comportement du code actuel : pas de "using" implicites, pas de nullabilité -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Images, carte et sons embarqués (mêmes noms de ressources qu'avant) -->
    <EmbeddedResource Include="asset\asset.png" />
    <EmbeddedResource Include="asset\maps\original_maze.txt" />
    <EmbeddedResource Include="asset\sounds\*.wav" />
	<EmbeddedResource Include="asset\demo.txt" Condition="Exists('asset\demo.txt')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
  </ItemGroup>

</Project>