<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Bibliothèque sans aucune dépendance à Windows : la logique du jeu, utilisable sous Windows, Linux et macOS -->
    <TargetFramework>net10.0</TargetFramework>

    <AssemblyName>PACMAN.Core</AssemblyName>
    <RootNamespace>PacmanWinForms</RootNamespace>

    <!-- On garde le comportement du code actuel : pas de "using" implicites, pas de nullabilité -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Images, carte et sons embarqués (mêmes noms de ressources qu'avant : PacmanWinForms.asset.xxx) -->
	<EmbeddedResource Include="asset\*\asset.png" />
	<EmbeddedResource Include="asset\*\maps\*.txt" />
	<EmbeddedResource Include="asset\*\sounds\*.wav" />
	<EmbeddedResource Include="asset\*\demo.txt" />
  </ItemGroup>

</Project>
